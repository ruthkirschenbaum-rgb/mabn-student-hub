# Add in Vercel > mabn-student-hub > Settings > Environment Variables.
# Never commit real values. The sender and recipient are qcmabnstudentreps@gmail.com.
# Create an App Password while signed into that Google account.
GMAIL_APP_PASSWORD=
# Permanent Upstash Redis database (also powers the visit counter).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: dedicated secret for short-lived message deduplication receipts.
FEEDBACK_DEDUP_SECRET=
# Optional alternative to Gmail: Resend with a verified domain.
RESEND_API_KEY=
FEEDBACK_FROM=
