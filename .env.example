# Add these in Vercel > project Settings > Environment Variables, then redeploy.
# Never commit real values. Use a permanent Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A Resend API key and a sender on a verified Resend domain.
RESEND_API_KEY=
FEEDBACK_FROM=
# Optional: dedicated secret for short-lived message deduplication receipts.
FEEDBACK_DEDUP_SECRET=
